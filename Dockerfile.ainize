# ainize build for a library (no server of its own): install, compile, run the offline unit tests,
# generate the typedoc API reference, and serve it as a static site on $PORT.
# Tests that need a live AIN blockchain node (ain, ain_raw, event_manager, knowledge, knowledge-e2e)
# are not run here — see ./Dockerfile + test-pipeline.sh for the full integration pipeline.
FROM node:20 AS build
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build
RUN npx jest __tests__/he.test.ts __tests__/llm.test.ts __tests__/knowledge-graph.test.ts __tests__/knowledge-ai.test.ts
RUN npx typedoc --plugin @mxssfd/typedoc-theme --theme my-theme --out docs

FROM busybox:1.36
COPY --from=build /app/docs /www
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec httpd -f -v -p 0.0.0.0:${PORT} -h /www"]
